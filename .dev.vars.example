# Local Wrangler preview bindings. Copy to .dev.vars and replace every placeholder.
# This file is only for `npm run cloudflare:preview`, is never deployed and must
# never be used as a source of production Worker secrets.

NEXT_PUBLIC_SUPABASE_URL="https://<staging-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<staging-key>"
SUPABASE_SECRET_KEY="<staging-secret-key>"
ADMIN_IMPORT_SECRET="<staging-admin-secret>"
PUBLIC_WISHLIST_ACCESS_SESSION_SECRET="<at-least-32-random-characters>"
MATS_ACCESS_CODE="<staging-mats-access-code>"
MATS_ACCESS_CODE_VERSION="<staging-mats-access-code-version>"
APP_ORIGIN="http://localhost:8787"
MULTI_WISHLIST_ENABLED="true"
PUBLICATION_ENABLED="true"
PRODUCT_IMPORT_ENABLED="true"
LEGACY_MATS_ADMIN_ENABLED="true"
INTERNAL_CRON_SECRET="<staging-cron-secret>"
INTERNAL_PROVISIONING_SECRET="<staging-provisioning-secret>"
BREVO_API_KEY="<brevo-api-key>"
BREVO_SENDER_EMAIL="anfragen@send.loriz.digital"
BREVO_SENDER_NAME="Wünschi"
# Optional:
# BREVO_REPLY_TO_EMAIL="anfragen@send.loriz.digital"
# BREVO_INVITATION_TEMPLATE_ID="42"
