NEXT_PUBLIC_SUPABASE_URL=
# Neuer Publishable Key aus Supabase (kein Service-/Secret-Key im Browser):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur bei älteren Supabase-Projekten als Alternative zum Publishable Key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Nur für ältere Supabase-Projekte als Alternative zu SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_IMPORT_SECRET=
# Produktion: https://wünschi.de
APP_ORIGIN=http://localhost:3000
MULTI_WISHLIST_ENABLED=false
SELF_SERVICE_SIGNUP_ENABLED=false
PUBLICATION_ENABLED=false
PRODUCT_IMPORT_ENABLED=false
LEGACY_MATS_ADMIN_ENABLED=true
# Erforderlich ausschließlich für den extern geplanten, täglichen Löschlauf:
INTERNAL_CRON_SECRET=
# Separates Geheimnis für die manuelle Aufnahme einer Familie in die geschlossene Beta:
INTERNAL_PROVISIONING_SECRET=
STAGING_ENVIRONMENT=staging
STAGING_ACCEPTANCE_CONFIRMATION=run-staging-acceptance
# Nur für npm run test:staging: muss mit dem Subdomain-Ref der Staging-URL übereinstimmen.
STAGING_SUPABASE_PROJECT_REF=
# PostgreSQL-Admin-URL ausschließlich für die transaktionale Staging-Testbereinigung.
# Passwort/Sonderzeichen müssen URL-kodiert sein; niemals im Browser oder Git verwenden.
STAGING_DATABASE_URL=
# Zusätzliche, explizite Freigabe für die Postgres-Admin-Bereinigung.
STAGING_CLEANUP_CONFIRMATION=cleanup-staging-acceptance
